  "cycles": [
    {
      "cycle": 1,
      "scene": "first_memory",
      "text": "My earliest memory wasn't really mine.",
      "glossary_keys": [],
      "glossary_open_close": true,
      "people_open_select_close": true,
      "dialogue_unchanged_by_menus": true
    },
    {
      "cycle": 2,
      "scene": "first_memory",
      "text": "It belonged to the people who brought me home.",
      "glossary_keys": [],
      "glossary_open_close": true,
      "people_open_select_close": true,
      "dialogue_unchanged_by_menus": true
    },
    {
      "cycle": 3,
      "scene": "first_memory",
      "text": "They told me about the Sanctuary. About my First Breath, and the five pairs of hands waiting to hold me.",
      "glossary_keys": [
        "first_breath",
        "sanctuary"
      ],
      "glossary_open_close": true,
      "people_open_select_close": true,
      "dialogue_unchanged_by_menus": true
    },
    {
      "cycle": 4,
      "scene": "first_memory",
      "text": "In every telling, someone remembered a different thing: the sound I made, or the way I gripped a finger and wouldn't let go.",
      "glossary_keys": [
        "first_breath",
        "sanctuary"
      ],
      "glossary_open_close": true,
      "people_open_select_close": true,
      "dialogue_unchanged_by_menus": true
    },
    {
      "cycle": 5,
      "scene": "first_memory",
      "text": "I used to ask them to tell it again. They always began with the joy of it.",
      "glossary_keys": [
        "first_breath",
        "sanctuary"
      ],
      "glossary_open_close": true,
      "people_open_select_close": true,
      "dialogue_unchanged_by_menus": true
    },
    {
      "cycle": 6,
      "scene": "first_memory",
      "text": "Only later did I wonder how nervous they'd been. They'd brought Kael home before me, but did that make it any easier?",
      "glossary_keys": [
        "first_breath",
        "sanctuary"
      ],
      "glossary_open_close": true,
      "people_open_select_close": true,
      "dialogue_unchanged_by_menus": true
    },
    {
      "cycle": 7,
      "scene": "first_memory",
      "text": "Lumen, the child of Aurora and Nyx, was still a young world when I was born.",
      "glossary_keys": [
        "first_breath",
        "lumen",
        "sanctuary"
      ],
      "glossary_open_close": true,
      "people_open_select_close": true,
      "dialogue_unchanged_by_menus": true
    },
    {
      "cycle": 8,
      "scene": "first_memory",
      "text": "My own parents were Maia, Arin, Selene, Dorian, and Sage.",
      "glossary_keys": [
        "first_breath",
        "lumen",
        "sanctuary"
      ],
      "glossary_open_close": true,
      "people_open_select_close": true,
      "dialogue_unchanged_by_menus": true
    }
  ],
